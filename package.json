{
  "name": "ai-data-service",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight, local-first client for Alibaba Cloud ADA (AI-native big data service), built on the public Ada/2026-07-01 OpenAPI.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prestart": "node scripts/check-node.mjs",
    "start": "vite build && node --disable-warning=ExperimentalWarning server/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev.ts",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.ts",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.2.1",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "vite": "8.3.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
