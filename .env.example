# Optional. You can also enter credentials on the setup page after `npm start`.
# Copy this file to `.env.local`, or export the variables in your shell. Environment variables take precedence.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# Only needed for temporary STS credentials.
# ALIBABA_CLOUD_SECURITY_TOKEN=

# cn-hangzhou, cn-shanghai or cn-beijing
ADA_REGION=cn-hangzhou

# Local port, 8787 by default.
# OPEN_ADA_PORT=8787
